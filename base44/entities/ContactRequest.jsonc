{
  "name": "ContactRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u043a\u043b\u0438\u0435\u043d\u0442\u0430"
    },
    "phone": {
      "type": "string",
      "description": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d \u043a\u043b\u0438\u0435\u043d\u0442\u0430"
    },
    "email": {
      "type": "string",
      "description": "Email \u043a\u043b\u0438\u0435\u043d\u0442\u0430"
    },
    "message": {
      "type": "string",
      "description": "\u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043e\u0442 \u043a\u043b\u0438\u0435\u043d\u0442\u0430"
    },
    "source": {
      "type": "string",
      "enum": [
        "hero",
        "services",
        "project",
        "contacts",
        "consultation"
      ],
      "description": "\u041e\u0442\u043a\u0443\u0434\u0430 \u043f\u0440\u0438\u0448\u043b\u0430 \u0437\u0430\u044f\u0432\u043a\u0430"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "completed"
      ],
      "default": "new",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u0437\u0430\u044f\u0432\u043a\u0438"
    }
  },
  "required": [
    "name",
    "phone"
  ]
}